# Template. Not installed by anything in this repo -- see README.md beside it.
#
# One vhost serves both the page and the service, so the page's origin and the
# lobby's are the same. That is worth doing deliberately: it means no CORS to
# get wrong, one certificate, and no second name to renew or explain.

# Required for the relay. `proxy_set_header Connection $connection_upgrade`
# needs this map, and a plain `Connection: upgrade` would break every ordinary
# request that is not one.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    listen [::]:80;
    server_name mcpe.continualmi.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name mcpe.continualmi.com;

    ssl_certificate     /etc/letsencrypt/live/mcpe.continualmi.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/mcpe.continualmi.com/privkey.pem;

    root /var/www/mcpe;
    index index.html;

    # The .data file is 3.8M and the wasm larger; both are fetched before
    # anything is playable.
    gzip on;
    gzip_types application/javascript application/wasm text/html;
    gzip_min_length 1024;

    # The board and the switch. The trailing slash on proxy_pass strips /lobby,
    # so the service sees the routes it actually serves.
    location /lobby/ {
        proxy_pass http://127.0.0.1:8477/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;

        # Overwrite, never append. The per-source cap counts players per IP, and
        # $proxy_add_x_forwarded_for would let a client prepend whatever it
        # liked and walk straight through it. MCPE_LOBBY_TRUST_PROXY=1 in the
        # unit is what makes the service believe this header, and it is only
        # safe because of this line.
        proxy_set_header X-Forwarded-For $remote_addr;

        # A relay socket is long-lived and quiet whenever both players are
        # standing still. The default 60s would cut them mid-game.
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # The build is replaced wholesale by sync-from-pages.sh and the filenames
    # never change, so a cached index.html would keep serving the old wasm.
    location = /index.html {
        add_header Cache-Control "no-store";
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
