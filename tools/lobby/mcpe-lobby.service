# Template. Not installed by anything in this repo -- copy it to
# /etc/systemd/system/ yourself, on whichever box is going to host the lobby.
#
#   sudo cp tools/lobby/mcpe-lobby.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now mcpe-lobby
#   curl -s localhost:8477            # says what it is
#
# It binds to 127.0.0.1 on purpose. The page is served over https from
# github.io, so a browser will refuse to fetch http from it -- reaching this
# from the public internet means a reverse proxy in front terminating TLS, and
# that is a deliberate decision about exposing a box rather than a default this
# file should make for you.
#
# Stopping it is a supported state, not an outage: the Join card goes back to
# an empty list, which is what it showed before the lobby existed.

[Unit]
Description=mcpe-lobby -- presence list for the MCPE 0.6.1 web build
Documentation=https://github.com/luispl77/mcpe-0.6.1-web/blob/main/tools/lobby/README.md
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/node /opt/mcpe-lobby/server.js
Environment=MCPE_LOBBY_HOST=127.0.0.1
Environment=MCPE_LOBBY_PORT=8477
Restart=on-failure
RestartSec=5

# It holds one Map of throwaway strings and talks to nothing. None of the
# below is load-bearing for it working; it is here because a service reachable
# from the internet should not also be able to reach the rest of the box.
DynamicUser=yes
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=no
SystemCallFilter=@system-service
MemoryMax=128M

[Install]
WantedBy=multi-user.target
