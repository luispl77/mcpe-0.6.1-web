# Template. Not installed by anything in this repo -- copy it to
# /etc/systemd/system/ yourself, on whichever box is going to host the worlds.
#
#   sudo cp tools/servers/mcpe-servers.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now mcpe-servers
#   curl -s 127.0.0.1:8478            # says what it is
#
# Unlike the lobby this does NOT use DynamicUser: it owns directories that have
# to still be there tomorrow, and a world whose files change owner on restart is
# a world that is gone. Create the user and the root first:
#
#   sudo useradd --system --home-dir /var/lib/mcpe-worlds --shell /usr/sbin/nologin mcpe
#   sudo install -d -o mcpe -g mcpe -m 750 /var/lib/mcpe-worlds
#
# The game binds its UDP port on 0.0.0.0 -- that is 2013's default and not worth
# patching -- so the firewall is what keeps those ports off the internet. Only
# the relay needs to reach them, and it does so over loopback. Check with
# `sudo ufw status` before believing this file.

[Unit]
Description=mcpe-servers -- dedicated worlds for the MCPE 0.6.1 web build
Documentation=https://github.com/luispl77/mcpe-0.6.1-web/blob/main/tools/servers/README.md
After=network.target

[Service]
Type=simple
User=mcpe
Group=mcpe
ExecStart=/usr/bin/node /opt/mcpe-servers/manager.js
Environment=MCPE_MANAGER_HOST=127.0.0.1
Environment=MCPE_MANAGER_PORT=8478
Environment=MCPE_SERVER_BIN=/opt/mcpe-servers/mcpe_server
Environment=MCPE_SERVERS_ROOT=/var/lib/mcpe-worlds
Environment=MCPE_SERVERS_FILE=/var/lib/mcpe-worlds/servers.json
Restart=on-failure
RestartSec=5

# It spawns game processes and owns their worlds, so it gets less of the box
# than the lobby does, not more -- the one thing it is allowed to write is the
# world root.
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/mcpe-worlds
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes

# Children live in this cgroup, so this is the ceiling for the manager *and*
# every world under it. A world measured at 38 MB resident with nobody in it;
# eight of them plus node is around 380 MB, so this is roughly 2x headroom.
# MCPE_MAX_SERVERS is the knob that decides how many there can be -- this is the
# backstop for when that knob is wrong.
MemoryMax=768M

# SIGTERM to the manager and to nothing else, because the manager is the only
# thing here that knows how to stop a world properly.
#
# This said control-group, which is what the comment above it described and the
# opposite of what it did: systemd sent SIGTERM to *every* process in the cgroup
# at once, so all four worlds died where they stood before the manager's own
# handler had run a line. main_dedicated traps SIGINT and saves; it does not
# trap SIGTERM, whose default disposition is to die immediately. So every
# `systemctl restart mcpe-servers` -- every deploy -- threw away whatever had
# not already reached the disk. The journal said so out loud and nobody read it:
# `exited (code null, signal SIGTERM)`.
#
# mixed is the shape the comment always meant. Nothing is orphaned by it: the
# children are the manager's own, it SIGINTs each one and now waits for them,
# and SendSIGKILL still sweeps up anything left after TimeoutStopSec.
KillMode=mixed
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
